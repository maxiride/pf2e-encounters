# Configuration for fetch-creatures-playwright.js
# Adjust values as needed. Booleans accept true/false, 1/0, yes/no.

# The AoN creatures page URL to export from
PAGE_URL=https://2e.aonprd.com/Creatures.aspx?sort=name-asc&display=table&columns=creature_family+rarity+size+trait+level+hp+ac+source+url+alignment

# Output file path (relative to project root or absolute)
OUT=../../public/creatures.json

# Playwright settings
HEADLESS=true
KEEP_OPEN=false
KEEP_OPEN_ON_ERROR=true
SLOW_MO=500

# Optional custom user agent string (leave empty to use browser default)
USER_AGENT=

# Logging verbosity (trace when true, info when false)
VERBOSE=false
